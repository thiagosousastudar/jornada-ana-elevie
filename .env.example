# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase › Project Settings › API). Estas duas são públicas por natureza:
# a segurança vem das regras de acesso (RLS) do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Slug da campanha ativa (ver supabase/seed.sql)
VITE_CAMPANHA_SLUG=edicao-1

# WhatsApp da equipe para "esqueci minha senha" (só números, com DDI e DDD). Ex.: 5514999999999
VITE_WHATSAPP_SUPORTE=

# NUNCA coloque a service_role key aqui nem no código do app.
